# Root-level reference for docker-compose and Makefile targets.
# Copy to `.env` (git-ignored) only if you use docker-compose. Placeholders only.
# Service-specific templates live in backend/.env.example and frontend/.env.example.

# Local PostgreSQL started by docker-compose (development only)
POSTGRES_USER=exl_dev
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=exl_advisor
POSTGRES_PORT=54329
