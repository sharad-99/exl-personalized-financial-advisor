# --- Secrets: never commit real environment files ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/
build/
dist/

# --- Local data (regenerate with `make data` / `make seed`) ---
backend/data/*.db
backend/data/*.db-*
backend/data/generated/
data/generated/

# --- Node / Next.js ---
node_modules/
frontend/.next/
frontend/out/
frontend/next-env.d.ts
frontend/test-results/
frontend/playwright-report/
*.tsbuildinfo
npm-debug.log*

# --- Supabase local CLI state ---
supabase/.branches/
supabase/.temp/

# --- OS / editors ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
