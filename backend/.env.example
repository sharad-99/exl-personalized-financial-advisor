# Copy to backend/.env (git-ignored) and replace placeholders. Never commit real values.

ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO

# SQLite needs no setup (local demo). For PostgreSQL / Supabase use the pooled
# connection string from Supabase > Project Settings > Database, e.g.
# DATABASE_URL=postgresql://exl_api.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./data/local.db

# --- Authentication ---------------------------------------------------------
# local    = development-only demo login for SYNTHETIC seeded users (blocked in production)
# supabase = verify Supabase Auth access tokens
AUTH_MODE=local
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
LOCAL_JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
LOCAL_DEMO_PASSWORD=replace-with-a-local-demo-password
LOCAL_TOKEN_TTL_MINUTES=480

# Supabase mode (server-side only). The public URL is not secret.
SUPABASE_URL=https://your-project-ref.supabase.co
# Only needed for projects still using legacy HS256 JWT signing. Keep server-side.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# --- HTTP hardening ---------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
REQUEST_TIMEOUT_SECONDS=15
MAX_REQUEST_BODY_BYTES=65536
RATE_LIMIT_SENSITIVE_PER_MINUTE=20
RATE_LIMIT_LOGIN_PER_MINUTE=5
