# Copy to frontend/.env.local (git-ignored). Placeholders only.

# Server-side only: where the Next.js server reaches the FastAPI backend.
# Never prefix with NEXT_PUBLIC_ - the browser talks only to /api/backend.
API_BASE_URL=http://localhost:8000

# local    = development demo login via the backend (synthetic users only)
# supabase = Supabase Auth (email + password)
AUTH_MODE=local

# Supabase mode only. These two values are public by design (protected by RLS);
# never put the service-role key in the frontend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
